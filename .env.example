# Claude API key (required for resume tailoring and cover letter generation)
CLAUDE_API_KEY=sk-ant-...

# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password

# ATS API keys for direct application submission (optional)
GREENHOUSE_API_KEY=
LEVER_API_KEY=

# Rotating proxy URL for scraping (optional, recommended for LinkedIn)
PROXY_URL=
