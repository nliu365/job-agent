<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #333; max-width: 600px; margin: 0 auto; }
        h1 { color: #1a1a1a; font-size: 20px; }
        .job { border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
        .job-title { font-size: 16px; font-weight: 600; color: #0066cc; }
        .job-company { font-size: 14px; color: #555; }
        .job-meta { font-size: 12px; color: #888; margin-top: 4px; }
        .score { display: inline-block; background: #e8f5e9; color: #2e7d32; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }
        .footer { margin-top: 24px; font-size: 12px; color: #999; border-top: 1px solid #eee; padding-top: 12px; }
    </style>
</head>
<body>
    <h1>{{ count }} New Matching Job{{ 's' if count != 1 }} Found</h1>
    <p>The following jobs match your ML/AI engineering search criteria:</p>

    {% for job in jobs %}
    <div class="job">
        <div class="job-title">
            <a href="{{ job.url }}">{{ job.title }}</a>
        </div>
        <div class="job-company">{{ job.company }}</div>
        <div class="job-meta">
            {{ job.location }}
            &bull; Source: {{ job.source.value }}
            &bull; <span class="score">{{ "%.0f"|format(job.relevance_score * 100) }}% match</span>
        </div>
    </div>
    {% endfor %}

    <div class="footer">
        <p>This is an automated alert from your job-alert pipeline.</p>
    </div>
</body>
</html>
